-- ------------------------------------------------------------
-- Customers
-- ------------------------------------------------------------
drop table Customers;
CREATE TABLE Customers (
    CustomerId INT NOT NULL AUTO_INCREMENT,
    FirstName VARCHAR(255) NOT NULL,
    LastName VARCHAR(255) NULL,
    Email VARCHAR(255) NOT NULL,
    Password VARCHAR(255) NULL,
    MobileNo VARCHAR(255) NULL,
    AadhaarNo VARCHAR(255) NULL,
    PanNo VARCHAR(255) NULL,
    Age INT NULL,
    EmploymentType VARCHAR(255) NULL,
    MonthlyIncome DECIMAL(38,2) NULL,
    MonthlyInvestment DECIMAL(38,2) NULL,
    IsEmailVerified BIT(1) NOT NULL,
    VerificationOtpHash VARCHAR(255) NULL,
    VerificationOtpExpiry DATETIME(6) NULL,
    CreatedAt DATETIME(6) NOT NULL,

    PRIMARY KEY (CustomerId),
    UNIQUE KEY UX_Customers_Email (Email)
) ENGINE=InnoDB;



