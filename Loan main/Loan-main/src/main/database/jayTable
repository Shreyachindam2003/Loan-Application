CREATE TABLE IF NOT EXISTS LoanDecisionEmails (
    EmailId BIGINT NOT NULL AUTO_INCREMENT,
    DealId INT NOT NULL,
    Recipient VARCHAR(255) NOT NULL,
    Subject VARCHAR(255) NOT NULL,
    Body TEXT NOT NULL,

    Status VARCHAR(20) NOT NULL DEFAULT 'PENDING',
    Attempts INT NOT NULL DEFAULT 0,

    NextAttemptAt DATETIME(6)
        NOT NULL DEFAULT CURRENT_TIMESTAMP(6),

    CreatedAt DATETIME(6)
        NOT NULL DEFAULT CURRENT_TIMESTAMP(6),

    SentAt DATETIME(6) NULL,

    PRIMARY KEY (EmailId),
    UNIQUE KEY UK_LoanDecisionEmails_DealId (DealId),

    CONSTRAINT FK_LoanDecisionEmails_LoanDeals
        FOREIGN KEY (DealId)
        REFERENCES LoanDeals (DealId)
);




